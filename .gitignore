# Competition rasters and other large inputs are NEVER committed (see README data policy)
data/*
!data/.gitkeep
!data/fetch_log.json
.cache/
*.npy
*.npz
__pycache__/
.pytest_cache/
*.pyc
.venv/
.venv*/
# Generated TIFs are not committed EXCEPT the one validated submission served for one-click download
*.tif
*.tiff
!docs/downloads/*.tif
*.zip
submissions/
